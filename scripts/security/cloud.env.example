# Шаблон значений для разовой настройки cloud-Vault (scripts/ops/cloud_bootstrap.sh).
#
# Скопируй в scripts/security/out/cloud.env (там gitignored) и заполни
# реальными значениями. В git этот пример — БЕЗ секретов.
#
#   cp scripts/security/cloud.env.example scripts/security/out/cloud.env
#   $EDITOR scripts/security/out/cloud.env
#
# Все значения — НЕ в git: out/ целиком в .gitignore.

# ── Yandex KMS (auto-unseal) ──────────────────────────────────────────
# ID симметричного KMS-ключа (идентификатор, не секрет, но держим вне git).
YC_KMS_KEY_ID=

# ── Managed PostgreSQL (приложение) ───────────────────────────────────
DB_DSN=postgresql://USER:PASS@HOST:PORT/DB

# ── Yandex Object Storage (артефакты миссий) ──────────────────────────
ARTIFACTS_S3_ENDPOINT=https://storage.yandexcloud.net
ARTIFACTS_S3_REGION=ru-central1
ARTIFACTS_S3_BUCKET=rescue-ai-artifacts
ARTIFACTS_S3_ACCESS_KEY_ID=
ARTIFACTS_S3_SECRET_ACCESS_KEY=

# ── Airflow (batch-контур) ────────────────────────────────────────────
AIRFLOW_DB_CONN=postgresql://USER:PASS@HOST:PORT/airflow
AIRFLOW_S3_CONN={"conn_type":"aws","extra":{"endpoint_url":"https://storage.yandexcloud.net","aws_access_key_id":"...","aws_secret_access_key":"..."}}

# ── Alertmanager (SMTP-алерты) ────────────────────────────────────────
ALERT_SMTP_SMARTHOST=smtp.gmail.com:587
ALERT_SMTP_FROM=mksk8410@gmail.com
ALERT_SMTP_USERNAME=mksk8410@gmail.com
# Gmail app-password — БЕЗ пробелов (16 символов слитно), иначе alertmanager.env
# ломается при source в шелле.
ALERT_SMTP_PASSWORD=
ALERT_WARNING_RECIPIENT=mksk8410@gmail.com
ALERT_CRITICAL_RECIPIENT=mksk8410@gmail.com

# ── Grafana (admin) ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
