# Шаблон локального dev-окружения. Скопируй в .env и заполни:
#   cp .env.example .env
# Затем `docker compose up -d` (флаги/доп. env-файлы не нужны).
#
# Postgres и MinIO встроены в docker-compose (локальные), отдельный S3/БД
# для dev не нужны. Реальные облачные креды (Yandex S3, удалённая БД) в dev
# бесполезны и в прод-модели живут в Vault, а не здесь.

# ── Обязательные dev-секреты (локальные Postgres/MinIO) ──────────
# ARTIFACTS_S3_* для api выводятся из MINIO_* внутри docker-compose.yml.
POSTGRES_PASSWORD=<local-postgres-password>
MINIO_ROOT_USER=<local-minio-user>
MINIO_ROOT_PASSWORD=<local-minio-password-min-8-chars>
AIRFLOW_ADMIN_PASSWORD=<local-airflow-password>
GRAFANA_ADMIN_PASSWORD=<local-grafana-password>

# ── Raspberry Pi (mTLS), опционально ─────────────────────────────
# Нужен только для операторского режима. Нет Pi → TLS_MODE=off, и работает
# авто-режим (видео/zip/s3). Сертификат содержит IP в SAN — ходим по IP.
RPI_BASE_URL=https://<rpi-ip>:9100
RPI_MISSIONS_DIR=/home/<user>/missions
RPI_RTSP_PORT=8554
RPI_RTSP_PATH_PREFIX=live

TLS_MODE=mtls
TLS_CA_CERT_PATH=/app/certs/station-root-ca.crt
TLS_CLIENT_CERT_PATH=/app/certs/gcs-client.crt
TLS_CLIENT_KEY_PATH=/app/certs/gcs-client.key
